# Upstox Developer Credentials
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
UPSTOX_BASE_URL=https://api.upstox.com/v2

# Server Configuration
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite async. To switch to PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/algo_trader
DATABASE_URL=sqlite+aiosqlite:///./algo_trader.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005","http://127.0.0.1:3005"]

# Internal Security
JWT_SECRET_KEY=change_this_to_a_random_secret_in_production
JWT_ALGORITHM=HS256

# Trading System Defaults
DEFAULT_TRADING_MODE=LIVE
NIFTY_LOT_SIZE=25

